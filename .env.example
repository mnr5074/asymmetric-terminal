PORT=8000
HOST=0.0.0.0
# 1 = public hosting hardening: per-IP rate limits, custom RPC restricted to known providers
PUBLIC_MODE=
# Where research outputs live (analysis.json, screener.json, moonshot.db)
DATA_DIR=
# 1 = run the research collector loop inside the container (needs a persistent disk to be useful)
RUN_RESEARCH=0
# Optional unofficial fomoapi.io key for the Fomo ecosystem tab
FOMOAPI_KEY=
# Optional server-side Solana RPC (Helius/QuickNode URL with key)
SOLANA_RPC_URL=
# Password gate: when SITE_PASSWORD is set every page and /api/* (except /api/health) needs a login
SITE_PASSWORD=
SITE_USER=martin
# Signs the session cookie (any long random string; Render generates it)
SESSION_SECRET=
# Session lifetime in days (default 14)
SESSION_DAYS=
