PORT=8000
HOST=0.0.0.0
# 1 = public hosting hardening: per-IP rate limits, custom RPC restricted to known providers
PUBLIC_MODE=
# Where research outputs live (analysis.json, screener.json, moonshot.db)
DATA_DIR=
# 1 = run the research collector loop inside the container (needs a persistent disk to be useful)
RUN_RESEARCH=0
# Optional unofficial fomoapi.io key for the Fomo ecosystem tab
FOMOAPI_KEY=
# Optional server-side Solana RPC (Helius/QuickNode URL with key)
SOLANA_RPC_URL=
# Password gate: when SITE_PASSWORD is set every page and /api/* (except /api/health) needs a login
SITE_PASSWORD=
SITE_USER=martin
# Signs the session cookie (any long random string; Render generates it)
SESSION_SECRET=
# Session lifetime in days (default 14)
SESSION_DAYS=

# --- Live feed / desks ---
# LIVE_FEED=full        # full | lite (Solana/Base/BSC, fewer scans; use on Render free) | off
# LIVE_INTERVAL_MS=60000

# --- Text alerts (email-to-SMS). DRY RUN (logged to data/alerts.log) unless ALERTS_LIVE=1 and all SMTP vars are set ---
# ALERTS_LIVE=0
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587          # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password  # Gmail: an App Password (needs 2FA), not your normal password
# SMTP_FROM=you@gmail.com
# ALERT_TO=5551234567@tmomail.net   # carrier gateway: T-Mobile tmomail.net, Verizon vtext.com, AT&T txt.att.net (AT&T retired its SMS gateway in 2025; use an email/app instead)
# ALERT_MAX_PER_HOUR=10
# ALERT_QUIET=23-7       # local hours with no texts; "off" to disable
# ALERT_TZ=America/Los_Angeles
# ALERT_MIN_GRADE=A
# ALERT_DIGEST_HOURS=4   # follow-up text on earlier calls ("$X called 9:14 AM @0.0012 now +240%")

# --- Nansen (optional, server-side only; Pro plan = 2,000 credits/month top-up) ---
# NANSEN_API_KEY=
# NANSEN_DAILY_CREDITS=60
# NANSEN_MONTHLY_CREDITS=1800

# --- X API (optional, paid pay-per-use; only top-ranked tokens/tickers, cached 6h) ---
# X_BEARER_TOKEN=
# X_MONTHLY_CAP_USD=50
# X_DAILY_POSTS=330
# X_SAMPLE=20
# X_CACHE_H=6
# SEC_USER_AGENT="AsymmetricTerminal you@example.com"   # SEC asks for a contact in the User-Agent
